# Copy to .env:  cp .env.example .env
# JWT_SECRET_KEY must match pangeaUsers / pangeaMedia / pangeaConversations

JWT_SECRET_KEY=

# Optional: shared with Media for index/process callbacks later
INTERNAL_SERVICE_TOKEN=

# App
APP_ENV=development
LOG_LEVEL=info

# Part 2 — embeddings + Chroma
EMBEDDING_MODEL=google/embeddinggemma-300m
# Faster smoke test:
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=media_chunks
CHUNK_SIZE=800
CHUNK_OVERLAP=120
SEARCH_TOP_K=5
SEARCH_MIN_SCORE=0.35

# Part 3 — RQ + Whisper (Redis DB 1 recommended alongside Sidekiq on DB 0)
REDIS_URL=redis://127.0.0.1:6379/1
RQ_QUEUE_NAME=pangea_search
WHISPER_MODEL=tiny

# Extended Part 3 / Part 4 — Gemma via Ollama (fallback if down)
SUMMARIZE_ENABLED=true
RAG_ENABLED=true
GEMMA_API_URL=http://127.0.0.1:11434
GEMMA_MODEL=gemma2:2b
GEMMA_TIMEOUT_SECONDS=120
